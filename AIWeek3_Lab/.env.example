# Required for live agent runs that ask a model to choose tools.
# Offline deterministic tests can run without these values.
BASE_URL=
API_KEY=
MODEL_ID=

# Optional custom validator override. Leave blank to use the official OMG
# SysML v2 Pilot Jupyter kernel installed by setup_official_sysml_kernel.ps1.
# A custom wrapper accepts one candidate .sysml path and returns 0 on success.
SYSML_VALIDATOR=
